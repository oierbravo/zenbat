# Zenbat Telegram PDF bot – copy to .env (in repo root or bot/) and set your values.
# All ZENBAT_BOT_* options are optional except TELEGRAM_BOT_TOKEN.

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------
# Bot API token from @BotFather (e.g. after /newbot).
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ------------------------------------------------------------------------------
# Where to listen (default: DMs only)
# ------------------------------------------------------------------------------
# Listen to direct (private) messages. Default: 1 (on).
# ZENBAT_BOT_LISTEN_DMS=1
# Listen to channel posts. Default: 0 (off). Set to 1 to also handle PDFs and /reload_productos in channels.
# ZENBAT_BOT_LISTEN_CHANNELS=0

# ------------------------------------------------------------------------------
# Logging (terminal)
# ------------------------------------------------------------------------------
# Log level: quiet | none | error | info | debug | verbose. Default: info.
# quiet = only errors (clean output). verbose = debug, all file paths and load details.
# info = PDF received, download, parse phase; debug/verbose = + every file path and load.
# ZENBAT_BOT_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Directories
# ------------------------------------------------------------------------------
# Directory for the extraction library data (e.g. column-map.json).
# If set, the bot also looks for productos.xlsx here for price enrichment (unless ZENBAT_BOT_PRODUCTOS_PATH is set).
# ZENBAT_BOT_DATA_DIR=/path/to/data

# Path to productos.xlsx for price enrichment. If unset, uses DATA_DIR/productos.xlsx when DATA_DIR is set.
# ZENBAT_BOT_PRODUCTOS_PATH=/path/to/productos.xlsx

# Directory where the bot stores downloaded PDFs and generated result files.
# If unset, the system temp directory is used.
# ZENBAT_BOT_OUTPUT_DIR=/path/to/output

# ------------------------------------------------------------------------------
# Parse mode (for future use)
# ------------------------------------------------------------------------------
# How to parse PDFs: armario_then_lines (try armario, fallback to lines-only),
# armario_only, or lines_only. Default: armario_then_lines.
# ZENBAT_BOT_PARSE_MODE=armario_then_lines

# ------------------------------------------------------------------------------
# Armario output types (attach in reply when armario extraction succeeds)
# ------------------------------------------------------------------------------
# Set to 0, false, no or off to disable attaching that file. Default: all enabled.
# ZENBAT_BOT_OUTPUT_XLSX=1
# ZENBAT_BOT_OUTPUT_MD=1
# ZENBAT_BOT_OUTPUT_HTML=1
# ZENBAT_BOT_OUTPUT_CSV=1
# ZENBAT_BOT_OUTPUT_JSON=1

# ------------------------------------------------------------------------------
# Lines-only output types (attach when fallback to line-by-line parse is used)
# ------------------------------------------------------------------------------
# ZENBAT_BOT_OUTPUT_LINES_TXT=1
# ZENBAT_BOT_OUTPUT_LINES_JSON=1
